# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://atomquest:atomquest_secret@localhost:5432/atomquest"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_string"
JWT_REFRESH_SECRET="change_this_to_another_long_random_string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ─── OpenRouter AI ───────────────────────────────────────────────────────────
# Get your key at https://openrouter.ai
# Leave empty to use built-in smart mock suggestions (works without a key!)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-3.5-turbo"

# ─── Email (Nodemailer) ──────────────────────────────────────────────────────
# Leave ALL empty to use console-log mock (perfect for demo/hackathon)
# Emails will be printed to the backend terminal — no mail server needed!
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@atomquest.com"

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Create frontend/.env and set this:
VITE_API_URL="http://localhost:4000/api"
