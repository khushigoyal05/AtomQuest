###############################################
# AtomQuest Backend — Environment Variables
# Copy this file to .env and fill in your values
###############################################

# ── Database ──────────────────────────────────
# SQLite (zero-setup, great for local dev & demo)
DATABASE_URL="file:./dev.db"

# PostgreSQL (for production / Docker)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/atomquest"

# ── JWT Auth ───────────────────────────────────
JWT_SECRET="change_this_to_a_long_random_secret"
JWT_REFRESH_SECRET="change_this_to_another_long_random_secret"
JWT_EXPIRES_IN="24h"
JWT_REFRESH_EXPIRES_IN="7d"

# ── Server ─────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# ── AI Goal Suggestions (Optional) ────────────
# Leave empty to use built-in mock suggestions (works without a key)
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-3.5-turbo"

# ── Email Notifications (Optional) ────────────
# Leave empty to use console-log mock (great for demos, no SMTP needed)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@atomquest.com"
